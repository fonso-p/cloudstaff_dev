# Copy to .env (git-ignored) and fill in. Never commit .env.
#
# Adzuna API (apollo_emea/adzuna_check.py): from your account at https://developer.adzuna.com/
# Trial coverage check only: commercial lead-generation use needs a written licence from Adzuna
# (https://developer.adzuna.com/docs/terms_of_service).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Companies House API (apollo_emea/officers.py): free key from https://developer.company-information.service.gov.uk/
# (Manage applications -> Live -> REST key). Used for the current officers (directors) of each lead.
COMPANIES_HOUSE_API_KEY=
