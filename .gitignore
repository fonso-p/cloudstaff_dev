# Client Extraction (CS Jobs): resume exports are personal data. Data lives outside the repo
# (see that folder's CLAUDE.md); these rules are a safety net in case files get copied in.
Client Extraction (CS Jobs)/data/
Client Extraction (CS Jobs)/**/*.xlsx
Client Extraction (CS Jobs)/**/*.xls
Client Extraction (CS Jobs)/**/*.csv
Client Extraction (CS Jobs)/**/*.jsonl

# Churn Analysis: built dashboards and their data are saved locally (Desktop/Projects/Churn Analysis/Dashboards),
# never in the repo. These guard against old paths. Built by Churn Analysis/work/build_dashboards.py
Churn Analysis/outputs/
Churn Analysis/data/

# Lickimat: client data and built dashboards live on the Desktop (Projects/Client/Lickimat), never in the repo.
